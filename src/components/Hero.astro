---
import { hero, proof, site, thesis } from '../data/site';

const stats = proof.map((item) => {
  const prefix = 'prefix' in item && item.prefix ? item.prefix : '';
  const display =
    typeof item.value === 'number'
      ? `${prefix}${item.value.toLocaleString('en-US')}${item.suffix}`
      : `${prefix}${item.value}${item.suffix}`;
  return { ...item, display };
});

const pillars = [thesis.why, thesis.how, thesis.what];
---

<header class="hero" id="top">
  <div class="hero-stage">
    <h1 class="hero-name visually-hidden">{site.name}</h1>
    <p class="hero-kicker" data-island style="--i: 0">{hero.kicker}</p>
  </div>
  <div class="hero-body">
    <div class="hero-identity">
      <div class="hero-copy">
        <p class="lede" data-island style="--i: 1">{hero.lede}</p>
        <p class="hero-stack" data-island style="--i: 2">{hero.stack.join(' · ')}</p>
        <div class="hero-actions" data-island style="--i: 3">
          <a class="btn btn-solid" href="/#work">See the work</a>
          <a class="btn" href="/resume/">Resume</a>
          <a class="btn" href="/engage/">Engage</a>
        </div>
      </div>
      <figure class="hero-photo" data-island data-play data-island-kind="photo" style="--i: 2; --from-x: 48px; --from-y: -12px">
        <img src={site.photo} alt={site.name} width="320" height="320" fetchpriority="high" decoding="async" />
      </figure>
    </div>
    <ol class="thesis bento">
      {
        pillars.map((pillar, i) => (
          <li class="glass" data-island data-play data-depth={i === 0 ? '1' : '2'} style={`--i: ${4 + i}; --from-y: 36px`}>
            <p class="thesis-line">{pillar.line}</p>
            <p class="thesis-detail">{pillar.detail}</p>
          </li>
        ))
      }
    </ol>
    <ul class="hero-stats bento">
      {
        stats.map((item, i) => (
          <li class="glass" data-island data-depth="2" style={`--i: ${7 + i}; --from-y: 42px`}>
            <p
              class="proof-value"
              data-count-to={typeof item.value === 'number' ? item.value : undefined}
              data-prefix={typeof item.value === 'number' && 'prefix' in item && item.prefix ? item.prefix : undefined}
              data-suffix={typeof item.value === 'number' ? item.suffix : undefined}
            >
              {item.display}
            </p>
            <p class="proof-label">{item.label}</p>
            <p class="proof-hint">{item.hint}</p>
          </li>
        ))
      }
    </ul>
  </div>
</header>
