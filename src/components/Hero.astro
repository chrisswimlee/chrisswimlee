---
import { hero, site } from '../data/site';
---

<header class="hero" id="top">
  <div class="hero-stage"></div>
  <div class="hero-body">
    <div class="hero-identity">
      <p class="hero-kicker" data-island style="--i: 0">{hero.kicker}</p>
      <h1 class="hero-name" data-island style="--i: 1">Chris <em>Swim</em> Lee</h1>
      <p class="lede" data-island style="--i: 2">{hero.lede}</p>
      <ul class="hero-method" data-island style="--i: 3">
        {hero.constraints.map((line) => <li>{line}</li>)}
      </ul>
      <figure class="hero-photo" data-island data-play data-island-kind="photo" style="--i: 5">
        <img src={site.photo} alt={site.name} width="320" height="320" fetchpriority="high" decoding="async" />
      </figure>
      <div class="hero-actions" data-island style="--i: 4">
        {
          hero.actions.map((action, index) => (
            <a class:list={['btn', index === 0 && 'btn-solid']} href={action.href}>{action.label}</a>
          ))
        }
      </div>
    </div>
  </div>
</header>
