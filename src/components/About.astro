---
import { about, built, record } from '../data/site';
---

<section class="section" id="about">
  <div class="section-head">
    <h2>About</h2>
    <p class="note" data-reveal>{about.lede}</p>
  </div>
  <div class="prose" data-reveal>
    {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <div class="record-links">
      <p class="kicker">The record</p>
      {record.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer">
          {link.label}
        </a>
      ))}
    </div>
  </div>
  <div class="built" data-reveal>
    <p class="kicker">{built.lede}</p>
    <p>{built.detail}</p>
    <div class="card-links">
      <a class="btn" href={built.href} target="_blank" rel="noopener noreferrer">Site source</a>
    </div>
  </div>
</section>
