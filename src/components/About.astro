---
import { about, built } from '../data/site';
---

<section class="section" id="about">
  <div class="section-head">
    <h2>About</h2>
    <p class="note">{about.lede}</p>
  </div>
  <div class="prose" data-reveal>
    {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
  <div class="built" data-reveal>
    <p class="kicker">{built.lede}</p>
    <p>{built.detail}</p>
    <div class="card-links">
      <a class="btn" href={built.href} target="_blank" rel="noopener noreferrer">Site source</a>
    </div>
  </div>
</section>
