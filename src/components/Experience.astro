---
import { education, experienceIntro, roles, skills } from '../data/site';
---

<section class="section notebook" id="experience">
  <div class="section-head">
    <h2>Experience</h2>
    <p class="note" data-reveal>{experienceIntro}</p>
  </div>
  <div class="timeline">
    {
      roles.map((role) => (
        <article class="role role-scan role-explore" data-reveal>
          <details class="role-fold" id={role.id}>
            <summary class="role-summary">
              <div class="when-col">
                <p class="when">{role.dates}</p>
                {role.location && <p class="when">{role.location}</p>}
              </div>
              <div>
                <h3>{role.title}</h3>
                <p class="company">{role.company}</p>
                <p class="role-note">{role.scan}</p>
              </div>
            </summary>
            <div class="role-projects">
              {role.projects.map((project) => (
                <details class="project-fold">
                  <summary class="project-summary">
                    <span class="project-title">{project.title}</span>
                    <span class="project-line">{project.oneLiner}</span>
                  </summary>
                  <div class="project-body">
                    {project.points.length > 0 && (
                      <ul>
                        {project.points.map((point) => (
                          <li>{point}</li>
                        ))}
                      </ul>
                    )}
                    <p class="project-jump">
                      <a href={`/experience/#${project.id}`}>Open in archive</a>
                    </p>
                  </div>
                </details>
              ))}
            </div>
          </details>
        </article>
      ))
    }
  </div>

  <p class="resume-jump" data-reveal>
    <a class="btn btn-solid" href="/experience/">Full archive</a>
    <a class="btn" href="/resume/">Resume</a>
  </p>

  <div class="resume-extras" data-reveal>
    <div>
      <h3 class="kicker">Education</h3>
      <ul class="edu-list">
        {
          education.map((item) => (
            <li>
              <p class="when">{item.dates}</p>
              <p class="edu-degree">{item.degree}</p>
              <p class="edu-school">{item.school}</p>
              {item.note && <p class="edu-note">{item.note}</p>}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="skills-panel">
      <h3 class="kicker">Skills</h3>
      {
        Object.entries(skills).map(([group, items]) => (
          <div class="skill-block">
            <h3>{group}</h3>
            <div class="tags">
              {items.map((item) => (
                <span class="tag">{item}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import '../scripts/open-hash-details';
</script>
