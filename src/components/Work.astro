---
import { projects, work } from '../data/site';
---

<section class="section" id="work">
  <div class="section-head">
    <h2>Work</h2>
    <p class="note" data-reveal>{work.lede}</p>
  </div>
  <div class="work-board">
    {
      projects.map((project) => {
        const live = project.links[0];
        const offsite = live ? /^https?:\/\//.test(live.href) : false;
        return (
          <article class:list={['work-piece', project.featured && 'work-feature']} data-reveal>
            {
              project.command ? (
                <div class="polaroid polaroid-cmd">
                  <code>{project.command}</code>
                  {project.commandNote && <p class="cmd-roles">{project.commandNote}</p>}
                  <button class="cmd-copy" type="button" data-copy={project.command}>
                    Copy
                  </button>
                </div>
              ) : (
                project.image &&
                live && (
                  <a
                    class="polaroid"
                    href={live.href}
                    aria-label={project.title}
                    target={offsite ? '_blank' : undefined}
                    rel={offsite ? 'noopener noreferrer' : undefined}
                  >
                    <img
                      src={project.image}
                      alt={`${project.title} — ${project.url}`}
                      width="1200"
                      height="750"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                )
              )
            }
            <p class="kicker">
              {project.kind} · {project.year}
            </p>
            <h3>{project.title}</h3>
            {project.url && <p class="case-url">{project.url}</p>}
            <p>{project.summary}</p>
            {
              project.points.length > 0 && (
                <ul class="points">
                  {project.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              )
            }
            <div class="card-links">
              {project.links.map((link) => {
                const offsite = /^https?:\/\//.test(link.href);
                const github = link.label === 'GitHub';
                return (
                  <a
                    class:list={['btn', link === live && 'btn-solid', github && 'btn-text']}
                    href={link.href}
                    target={offsite ? '_blank' : undefined}
                    rel={offsite ? 'noopener noreferrer' : undefined}
                  >
                    {link.label}
                  </a>
                );
              })}
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<script>
  import '../scripts/copy-buttons';
</script>
