---
import WorkCard from './WorkCard.astro';
import { projects, work } from '../data/site';

const featured = projects.filter((project) => project.featured);
const rest = projects.filter((project) => !project.featured);
const note = Astro.props.note ?? work.lede;
---

<section class="section" id="work">
  <div class="section-head">
    <h2>Work</h2>
    <p class="note" data-reveal>{note}</p>
  </div>
  <div class="work-board">
    {featured.map((project) => <WorkCard project={project} />)}
    <div class="work-rail">
      {rest.map((project) => <WorkCard project={project} />)}
    </div>
  </div>
</section>

<script>
  import '../scripts/copy-buttons';
</script>
