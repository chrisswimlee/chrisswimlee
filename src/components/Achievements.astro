---
import { achievementsNote, technicalAchievements } from '../data/site';
---

<section class="section" id="achievements">
  <div class="section-head">
    <h2>Record</h2>
    <p class="note" data-reveal>{achievementsNote}</p>
  </div>
  <ul class="achieve-grid">
    {
      technicalAchievements.map((item) => (
        <li class="achieve-card glass" data-reveal>
          <p class="kicker">{item.place}</p>
          <p class="when">{item.when}</p>
          <h3>{item.claim}</h3>
          <p>{item.proof}</p>
        </li>
      ))
    }
  </ul>
  <p class="resume-jump" data-reveal>
    <a class="btn btn-text" href="/experience/">Experience</a>
    <a class="btn btn-text" href="/resume/">Resume</a>
  </p>
</section>
