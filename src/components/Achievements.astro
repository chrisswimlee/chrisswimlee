---
import { achievementsNote, technicalAchievements } from '../data/site';
---

<section class="section" id="achievements">
  <div class="section-head">
    <h2>Achievements</h2>
    <p class="note" data-reveal>{achievementsNote}</p>
  </div>
  <ul class="achieve-grid">
    {
      technicalAchievements.map((item) => (
        <li class="achieve-card glass" data-reveal>
          <p class="kicker">{item.label}</p>
          <p class="achieve-value">
            {item.prefix && <span class="achieve-affix">{item.prefix}</span>}
            <span data-count-to={item.value}>
              {item.value.toLocaleString('en-US')}
            </span>
            {item.suffix && <span class="achieve-affix">{item.suffix}</span>}
          </p>
          <h3>{item.claim}</h3>
          <p>{item.proof}</p>
        </li>
      ))
    }
  </ul>
</section>
