---
const topos = [
  { id: 'lattice', label: 'Lattice' },
  { id: 'goldman', label: 'Goldman' },
  { id: 'trading', label: 'Trading engine' },
];
---

<div class="plane" data-plane>
  <div class="plane-chrome">
    <span class="plane-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="plane-title" data-plane-title>sys / local-lattice</span>
    <span class="plane-stat" data-plane-stat>model</span>
    <span class="plane-live"><i aria-hidden="true"></i> sim</span>
  </div>
  <div class="plane-tabs" role="tablist" aria-label="Systems">
    {
      topos.map((topo, i) => (
        <button
          type="button"
          role="tab"
          id={`plane-tab-${topo.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          data-topo={topo.id}
        >
          {topo.label}
        </button>
      ))
    }
  </div>
  <canvas
    class="plane-canvas"
    data-plane-canvas
    role="img"
    aria-label="Simulated architecture of Local Lattice, the Goldman beneficiary system, and the trading engine"
  ></canvas>
  <p class="plane-log" data-plane-log aria-hidden="true"></p>
</div>

<script>
  type Kind = 'src' | 'bus' | 'core' | 'out';
  type NodeDef = { id: string; x: number; y: number; label: string; kind: Kind };
  type EdgeDef = { from: string; to: string; warm?: boolean };
  type Topo = {
    title: string;
    nodes: NodeDef[];
    edges: EdgeDef[];
    logs: string[];
  };

  const TOPOS: Record<string, Topo> = {
    trading: {
      title: 'sys / trading-engine',
      nodes: [
        { id: 'nyse', x: 0.12, y: 0.2, label: 'NYSE', kind: 'src' },
        { id: 'nasdaq', x: 0.12, y: 0.44, label: 'NASDAQ', kind: 'src' },
        { id: 'crypto', x: 0.12, y: 0.68, label: 'CRYPTO', kind: 'src' },
        { id: 'sql', x: 0.36, y: 0.84, label: 'SQL', kind: 'src' },
        { id: 'kafka', x: 0.36, y: 0.44, label: 'KAFKA', kind: 'bus' },
        { id: 'agents', x: 0.62, y: 0.5, label: 'AGENTS', kind: 'core' },
        { id: 'signal', x: 0.88, y: 0.22, label: 'SIGNALS', kind: 'out' },
        { id: 'process', x: 0.88, y: 0.5, label: 'PROCESS', kind: 'out' },
        { id: 'brief', x: 0.88, y: 0.78, label: 'BRIEFING', kind: 'out' },
      ],
      edges: [
        { from: 'nyse', to: 'kafka' },
        { from: 'nasdaq', to: 'kafka' },
        { from: 'crypto', to: 'kafka' },
        { from: 'kafka', to: 'agents' },
        { from: 'sql', to: 'agents', warm: true },
        { from: 'agents', to: 'signal' },
        { from: 'agents', to: 'process' },
        { from: 'agents', to: 'brief' },
      ],
      logs: [
        'md.crypto          ingest',
        'md.equity          lag=11ms',
        'kafka              topic=md.*  p99=9ms',
        'agent              loop  sql audit',
        'process            pytorch  infer=14ms',
        'signal             bias=long  conf=0.71',
        'brief              pre-market ready',
      ],
    },
    goldman: {
      title: 'sys / beneficiary-mgmt',
      nodes: [
        { id: 'ingest', x: 0.12, y: 0.5, label: 'INGEST', kind: 'src' },
        { id: 'kafka', x: 0.36, y: 0.5, label: 'KAFKA', kind: 'bus' },
        { id: 'core', x: 0.62, y: 0.2, label: 'BENEFICIARY', kind: 'core' },
        { id: 'rest', x: 0.62, y: 0.42, label: 'REST', kind: 'core' },
        { id: 'tests', x: 0.62, y: 0.78, label: 'TESTNG', kind: 'out' },
        { id: 'accts', x: 0.88, y: 0.2, label: '10k ACCTS', kind: 'out' },
        { id: 'teams', x: 0.88, y: 0.5, label: '50+ TEAMS', kind: 'out' },
        { id: 'sel', x: 0.88, y: 0.78, label: 'SELENIUM', kind: 'out' },
      ],
      edges: [
        { from: 'ingest', to: 'kafka' },
        { from: 'kafka', to: 'core' },
        { from: 'kafka', to: 'rest' },
        { from: 'kafka', to: 'tests', warm: true },
        { from: 'core', to: 'accts' },
        { from: 'rest', to: 'teams' },
        { from: 'tests', to: 'sel', warm: true },
      ],
      logs: [
        'ingest             accounts batch',
        'kafka              topic=beneficiary',
        'process            −80% vs prior job',
        'rest               /v1/accounts  −15% p99',
        'fanout             teams=50+',
        'accounts           n=10000+',
        'testng             accuracy +22%',
        'selenium           kyc  pass',
      ],
    },
    lattice: {
      title: 'sys / local-lattice',
      nodes: [
        { id: 'mlx', x: 0.14, y: 0.22, label: 'MLX', kind: 'src' },
        { id: 'lms', x: 0.14, y: 0.5, label: 'LM STUDIO', kind: 'src' },
        { id: 'cloud', x: 0.14, y: 0.78, label: 'CLOUD', kind: 'src' },
        { id: 'gw', x: 0.5, y: 0.5, label: 'LATTICE', kind: 'core' },
        { id: 'coder', x: 0.86, y: 0.22, label: 'role:coder', kind: 'out' },
        { id: 'reason', x: 0.86, y: 0.5, label: 'role:reasoner', kind: 'out' },
        { id: 'fast', x: 0.86, y: 0.78, label: 'role:fast', kind: 'out' },
      ],
      edges: [
        { from: 'mlx', to: 'gw' },
        { from: 'lms', to: 'gw' },
        { from: 'cloud', to: 'gw', warm: true },
        { from: 'gw', to: 'coder' },
        { from: 'gw', to: 'reason' },
        { from: 'gw', to: 'fast' },
      ],
      logs: [
        'bind               mlx → lattice',
        'bind               lm-studio → lattice',
        'bind               cloud  fallback',
        'assign             role:coder → qwen2.5-coder',
        'assign             role:reasoner',
        'swarm              fanout n=3',
        'compat             POST /v1/chat/completions',
      ],
    },
  };

  const ACCENT = { r: 107, g: 159, b: 255 };
  const WARM = { r: 224, g: 177, b: 92 };

  function rgba(c: { r: number; g: number; b: number }, a: number) {
    return `rgba(${c.r}, ${c.g}, ${c.b}, ${a})`;
  }

  function initPlane(root: HTMLElement) {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-plane-canvas]');
    const titleEl = root.querySelector('[data-plane-title]');
    const statEl = root.querySelector('[data-plane-stat]');
    const logEl = root.querySelector('[data-plane-log]');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-topo]')];
    if (!canvas || !titleEl || !statEl || !logEl) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let topoId = 'lattice';
    let w = 0;
    let h = 0;
    let dpr = 1;
    let raf = 0;
    let visible = true;
    let last = 0;
    let logAt = 0;
    let logIdx = 0;
    let hits: number[] = [];
    type Node = NodeDef & { px: number; py: number; tw: number; pulse: number };
    type Particle = { e: number; t: number; speed: number; warm: boolean };
    let nodes: Node[] = [];
    let edges: EdgeDef[] = [];
    let particles: Particle[] = [];
    let spawnAcc = 0;

    function layout() {
      const rect = canvas.getBoundingClientRect();
      w = Math.max(1, Math.round(rect.width));
      h = Math.max(1, Math.round(rect.height));
      dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      canvas.style.width = `${w}px`;
      canvas.style.height = `${h}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.font = '500 11px "IBM Plex Mono", ui-monospace, monospace';
      const topo = TOPOS[topoId];
      nodes = topo.nodes.map((n) => ({
        ...n,
        px: n.x * w,
        py: n.y * h,
        tw: ctx.measureText(n.label).width,
        pulse: 0,
      }));
      edges = topo.edges;
    }

    function nodeById(id: string) {
      return nodes.find((n) => n.id === id)!;
    }

    function curve(a: Node, b: Node) {
      const mx = (a.px + b.px) / 2;
      const my = (a.py + b.py) / 2;
      const dx = b.px - a.px;
      const dy = b.py - a.py;
      const lift = Math.min(48, Math.hypot(dx, dy) * 0.18);
      return { mx: mx - dy * 0.08, my: my + Math.sign(dy || 1) * lift };
    }

    function pointOn(a: Node, b: Node, t: number) {
      const { mx, my } = curve(a, b);
      const u = 1 - t;
      return {
        x: u * u * a.px + 2 * u * t * mx + t * t * b.px,
        y: u * u * a.py + 2 * u * t * my + t * t * b.py,
      };
    }

    function setTopo(id: string) {
      if (!TOPOS[id]) return;
      topoId = id;
      titleEl.textContent = TOPOS[id].title;
      particles = [];
      hits = [];
      spawnAcc = 0;
      logIdx = 0;
      logEl.textContent = TOPOS[id].logs[0];
      for (const tab of tabs) {
        const on = tab.dataset.topo === id;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
      }
      layout();
      draw();
    }

    function spawn(dt: number) {
      spawnAcc += dt;
      const interval = 0.22;
      while (spawnAcc > interval) {
        spawnAcc -= interval;
        if (!edges.length) break;
        const e = Math.floor(Math.random() * edges.length);
        particles.push({
          e,
          t: 0,
          speed: 0.28 + Math.random() * 0.22,
          warm: !!edges[e].warm,
        });
      }
      if (particles.length > 36) particles.splice(0, particles.length - 36);
    }

    function tick(dt: number) {
      spawn(dt);
      for (const n of nodes) n.pulse = Math.max(0, n.pulse - dt * 2.4);
      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.t += p.speed * dt;
        if (p.t >= 1) {
          const edge = edges[p.e];
          const dest = nodeById(edge.to);
          if (dest) dest.pulse = 1;
          particles.splice(i, 1);
          hits.push(performance.now());
        }
      }
      logAt += dt;
      if (logAt > 1.7) {
        logAt = 0;
        const lines = TOPOS[topoId].logs;
        logIdx = (logIdx + 1) % lines.length;
        logEl.textContent = lines[logIdx];
      }
    }

    function drawBox(n: Node) {
      const padX = 10;
      const boxW = n.tw + padX * 2;
      const boxH = 24;
      const x = n.px - boxW / 2;
      const y = n.py - boxH / 2;
      const c = n.kind === 'bus' || n.kind === 'src' ? WARM : ACCENT;
      const fill =
        n.kind === 'core' ? rgba(ACCENT, 0.14 + n.pulse * 0.2) : `rgba(12, 18, 24, ${0.88 + n.pulse * 0.08})`;
      ctx.beginPath();
      const r = 6;
      ctx.moveTo(x + r, y);
      ctx.arcTo(x + boxW, y, x + boxW, y + boxH, r);
      ctx.arcTo(x + boxW, y + boxH, x, y + boxH, r);
      ctx.arcTo(x, y + boxH, x, y, r);
      ctx.arcTo(x, y, x + boxW, y, r);
      ctx.closePath();
      ctx.fillStyle = fill;
      ctx.fill();
      ctx.strokeStyle = rgba(c, 0.45 + n.pulse * 0.4);
      ctx.lineWidth = 1;
      ctx.stroke();
      ctx.fillStyle = n.kind === 'core' ? rgba(ACCENT, 1) : '#e8f4f5';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(n.label, n.px, n.py + 0.5);
    }

    function drawArrow(a: Node, b: Node, c: { r: number; g: number; b: number }) {
      const p = pointOn(a, b, 0.72);
      const q = pointOn(a, b, 0.8);
      const ang = Math.atan2(q.y - p.y, q.x - p.x);
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(ang);
      ctx.beginPath();
      ctx.moveTo(6, 0);
      ctx.lineTo(-4, -4.2);
      ctx.lineTo(-4, 4.2);
      ctx.closePath();
      ctx.fillStyle = rgba(c, 0.75);
      ctx.fill();
      ctx.restore();
    }

    function draw() {
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = '#070e1a';
      ctx.fillRect(0, 0, w, h);

      ctx.strokeStyle = 'rgba(232, 244, 245, 0.05)';
      ctx.lineWidth = 1;
      const gap = 28;
      ctx.beginPath();
      for (let x = 0; x <= w; x += gap) {
        ctx.moveTo(x + 0.5, 0);
        ctx.lineTo(x + 0.5, h);
      }
      for (let y = 0; y <= h; y += gap) {
        ctx.moveTo(0, y + 0.5);
        ctx.lineTo(w, y + 0.5);
      }
      ctx.stroke();

      for (let i = 1; i < 4; i++) {
        const y = (h / 4) * i;
        ctx.fillStyle = 'rgba(107, 159, 255, 0.035)';
        ctx.fillRect(0, y - 10, w, 20);
      }

      for (const edge of edges) {
        const a = nodeById(edge.from);
        const b = nodeById(edge.to);
        if (!a || !b) continue;
        const { mx, my } = curve(a, b);
        const c = edge.warm ? WARM : ACCENT;
        ctx.beginPath();
        ctx.moveTo(a.px, a.py);
        ctx.quadraticCurveTo(mx, my, b.px, b.py);
        ctx.strokeStyle = rgba(c, 0.28);
        ctx.lineWidth = 1.4;
        ctx.stroke();
        drawArrow(a, b, c);
      }

      for (const p of particles) {
        const edge = edges[p.e];
        const a = nodeById(edge.from);
        const b = nodeById(edge.to);
        if (!a || !b) continue;
        const { x, y } = pointOn(a, b, p.t);
        const c = p.warm ? WARM : ACCENT;
        ctx.beginPath();
        ctx.arc(x, y, 2.4, 0, Math.PI * 2);
        ctx.fillStyle = rgba(c, 0.95);
        ctx.shadowColor = rgba(c, 0.8);
        ctx.shadowBlur = 10;
        ctx.fill();
        ctx.shadowBlur = 0;
      }

      for (const n of nodes) drawBox(n);

      if (statEl) {
        const now = performance.now();
        hits = hits.filter((t) => now - t < 1000);
        statEl.textContent = `${hits.length}/s sim`;
      }
    }

    function loop(now: number) {
      if (!visible) return;
      const dt = Math.min(0.05, (now - last) / 1000 || 0.016);
      last = now;
      if (!reduce) tick(dt);
      draw();
      raf = requestAnimationFrame(loop);
    }

    function start() {
      cancelAnimationFrame(raf);
      last = performance.now();
      if (reduce) {
        draw();
        logEl.textContent = TOPOS[topoId].logs[0];
        return;
      }
      raf = requestAnimationFrame(loop);
    }

    const ro = new ResizeObserver(() => {
      layout();
      draw();
    });
    ro.observe(canvas);

    const io = new IntersectionObserver(
      (entries) => {
        visible = entries.some((e) => e.isIntersecting);
        if (visible) start();
        else cancelAnimationFrame(raf);
      },
      { threshold: 0.05 },
    );
    io.observe(root);

    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        const id = tab.dataset.topo || 'lattice';
        setTopo(id);
        window.dispatchEvent(new CustomEvent('system-select', { detail: { id } }));
      });
    }

    setTopo('lattice');
    start();
  }

  document.querySelectorAll<HTMLElement>('[data-plane]').forEach(initPlane);
</script>
