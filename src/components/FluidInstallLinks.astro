---
import { fluidSubtitlesRelease } from '../data/site';

const brew = fluidSubtitlesRelease.brew.join('\n');
---

<div class="hero-actions">
  <a class="btn btn-solid" href={fluidSubtitlesRelease.href}>
    Download {fluidSubtitlesRelease.name}
  </a>
</div>
<h3 id="homebrew">Homebrew</h3>
<div class="get-cmd">
  <code>{brew}</code>
  <button class="cmd-copy" type="button" data-copy={brew}>Copy</button>
</div>
