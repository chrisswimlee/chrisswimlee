---
import { engage } from '../data/site';
---

<div class="engage-block">
  <p>{engage.promise}</p>
  <ol class="engage-tiers">
    {
      engage.tiers.map((tier) => (
        <li>
          <p class="kicker">{tier.unit}</p>
          <strong>{tier.name}</strong>
          <p class="engage-price">{tier.price}</p>
          <p class="engage-detail">{tier.detail}</p>
        </li>
      ))
    }
  </ol>
  <ul class="services-notes">
    {engage.notes.map((note) => <li>{note}</li>)}
  </ul>
</div>
