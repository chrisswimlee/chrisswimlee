---
import { buildSystem, sectionMessages } from '../data/site';
---

<section class="section systems-section" id="systems">
  <div class="section-head">
    <h2>Build</h2>
    <p class="note" data-reveal>{sectionMessages.systems}</p>
  </div>

  <div class="prose build-prose" data-reveal>
    {buildSystem.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>

  <ul class="build-links">
    {
      buildSystem.links.map((link) => (
        <li>
          <a href={link.href} target="_blank" rel="noopener noreferrer">
            <span>{link.label}</span>
            <span class="build-hint">{link.hint}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
