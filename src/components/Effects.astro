<div class="fx-progress" aria-hidden="true"><i></i></div>
<div class="fx-grain" aria-hidden="true"></div>

<script>
  const motion = !matchMedia('(prefers-reduced-motion: reduce)').matches;
  const coarse = matchMedia('(pointer: coarse)').matches;

  const bar = coarse ? null : document.querySelector<HTMLElement>('.fx-progress i');
  if (bar) {
    let queued = false;
    const paint = () => {
      queued = false;
      const doc = document.documentElement;
      const max = Math.max(1, doc.scrollHeight - window.innerHeight);
      bar.style.transform = `scaleX(${Math.min(1, window.scrollY / max)})`;
    };
    addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(paint);
      },
      { passive: true },
    );
    addEventListener('resize', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(paint);
    }, { passive: true });
    paint();
  }

  if (motion) {
    const counters = [...document.querySelectorAll<HTMLElement>('[data-count-to]')];
    if (counters.length) {
      const ease = (t: number) => 1 - Math.pow(1 - t, 3);
      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const el = entry.target as HTMLElement;
            obs.unobserve(el);
            const target = Number(el.dataset.countTo);
            if (!Number.isFinite(target)) continue;
            const prefix = el.dataset.prefix ?? '';
            const suffix = el.dataset.suffix ?? '';
            const start = performance.now();
            const tick = (now: number) => {
              const t = Math.min(1, (now - start) / 1200);
              el.textContent = `${prefix}${Math.round(target * ease(t)).toLocaleString('en-US')}${suffix}`;
              if (t < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          }
        },
        { threshold: 0.4 },
      );
      counters.forEach((c) => io.observe(c));
    }
  }

  if (motion && !coarse) {
    const playables = [...document.querySelectorAll<HTMLElement>('[data-play]')];
    for (const card of playables) {
      if (card.classList.contains('fx-play')) continue;
      card.classList.add('fx-play');
      const max = card.dataset.islandKind === 'photo' ? 22 : 14;
      let grab: { x: number; y: number; ax: number; ay: number } | null = null;
      let angle = { x: 0, y: 0 };
      let vel = { x: 0, y: 0 };
      let coast = 0;
      const apply = (hoverX = 0, hoverY = 0) => {
        const rx = angle.x + hoverX;
        const ry = angle.y + hoverY;
        card.style.transform = rx || ry ? `perspective(900px) rotateX(${rx}deg) rotateY(${ry}deg)` : '';
      };
      const settle = () => {
        cancelAnimationFrame(coast);
        const tick = () => {
          vel.x *= 0.88;
          vel.y *= 0.88;
          angle.x += vel.x;
          angle.y += vel.y;
          angle.x += -angle.x * 0.14;
          angle.y += -angle.y * 0.14;
          apply();
          if (Math.hypot(angle.x, angle.y) > 0.12 || Math.hypot(vel.x, vel.y) > 0.06) {
            coast = requestAnimationFrame(tick);
          } else {
            angle = { x: 0, y: 0 };
            vel = { x: 0, y: 0 };
            card.style.transform = '';
          }
        };
        coast = requestAnimationFrame(tick);
      };
      card.addEventListener('pointerdown', (e) => {
        if (e.button && e.button !== 0) return;
        const target = e.target;
        if (target instanceof Element && target.closest('a, button')) return;
        cancelAnimationFrame(coast);
        grab = { x: e.clientX, y: e.clientY, ax: angle.x, ay: angle.y };
        vel = { x: 0, y: 0 };
        card.setPointerCapture(e.pointerId);
        card.classList.add('is-held');
      });
      card.addEventListener(
        'pointermove',
        (e) => {
          if (!grab) {
            const r = card.getBoundingClientRect();
            const px = (e.clientX - r.left) / r.width - 0.5;
            const py = (e.clientY - r.top) / r.height - 0.5;
            const deep = card.dataset.islandKind === 'photo' ? 8 : 5;
            apply(-py * deep, px * deep);
            return;
          }
          const nextX = Math.max(-max, Math.min(max, grab.ax - (e.clientY - grab.y) * 0.09));
          const nextY = Math.max(-max, Math.min(max, grab.ay + (e.clientX - grab.x) * 0.09));
          vel = { x: nextX - angle.x, y: nextY - angle.y };
          angle = { x: nextX, y: nextY };
          apply();
        },
        { passive: true },
      );
      const letGo = () => {
        if (!grab) return;
        grab = null;
        card.classList.remove('is-held');
        settle();
      };
      card.addEventListener('pointerup', letGo);
      card.addEventListener('pointercancel', letGo);
      card.addEventListener('pointerleave', () => {
        if (!grab) apply();
      });
    }
  }
</script>
