---
import { Image } from 'astro:assets';
import '../styles/hire.css';
import { hire, hireMail, site } from '../data/site';
---

<header class="hire-hero wrap" id="top">
  <div class="hire-hero-main">
    <p class="hire-status" data-island style="--i: 0">
      <span class="hire-dot" aria-hidden="true"></span>
      {hire.kicker}
    </p>
    <div class="hire-id" data-island style="--i: 1">
      <h1 class="hire-name">Chris <em>Swim</em> Lee</h1>
      <figure class="hire-photo">
        <Image
          src={site.photo}
          alt={`Portrait of ${site.legalName}`}
          width={220}
          height={220}
          densities={[1, 2]}
          format="webp"
          quality={82}
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
    <p class="hire-role" data-island style="--i: 2">{hire.role}</p>
    <p class="hire-lede" data-island style="--i: 3">{hire.lede}</p>
    <div class="hero-actions hire-actions" data-island style="--i: 4">
      <a class="btn btn-solid" href="/resume/">Resume</a>
      <a class="btn" href={hireMail}>Email me</a>
      <a class="btn" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a class="btn" href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a class="btn" href="/map/">System map</a>
    </div>
  </div>

  <dl class="hire-proof" data-island style="--i: 5">
    {
      hire.proof.map((item) => (
        <div class="hire-stat">
          <dt>
            <span class="hire-stat-value">{item.value}</span>
            <span class="hire-stat-label">{item.label}</span>
          </dt>
          <dd>{item.source}</dd>
        </div>
      ))
    }
  </dl>
</header>
