---
import { Image } from 'astro:assets';
import { localHost } from '../data/site';
---

<section class="section" id="localhost">
  <div class="section-head">
    <h2>{localHost.title}</h2>
    <p class="note" data-reveal>{localHost.kicker}</p>
  </div>
  <div class="product-dossier">
    <div>
      <p class="lede">{localHost.pitch}</p>
      <ul class="points">
        {localHost.points.map((point) => (
          <li>{point}</li>
        ))}
      </ul>
      <div class="card-links">
        {
          localHost.links.map((link, index) => (
            <a
              class:list={['btn', index === 0 && 'btn-solid', index > 0 && 'btn-text']}
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
    <a class="polaroid" href={localHost.links[0].href} target="_blank" rel="noopener noreferrer" aria-label="Visit local-host.ai">
      <Image
        src={localHost.image}
        alt="The local-host.ai homepage"
        widths={[480, 760, 1140]}
        sizes="(max-width: 980px) calc(100vw - 2.4rem), 500px"
        format="webp"
        quality={78}
        loading="lazy"
        decoding="async"
      />
    </a>
  </div>
</section>
