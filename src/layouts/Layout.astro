---
import '../styles/global.css';
import Effects from '../components/Effects.astro';
import Starfield from '../components/Starfield.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { education, site } from '../data/site';

const isResume = Astro.url.pathname.startsWith('/resume');
const isHome = Astro.url.pathname === '/';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const title = Astro.props.title ?? site.title;
const description = Astro.props.description ?? site.description;
const noindex = Astro.props.noindex ?? false;
const canonical = new URL(Astro.url.pathname, site.url).href;
const og = new URL(site.ogImage, site.url).href;
---

<!doctype html>
<html lang="en" class:list={[{ 'is-booting': isHome }]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.location}`} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content={`${site.name}, ${site.location}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,700;1,9..144,300;1,9..144,400;1,9..144,600&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: site.legalName,
      alternateName: site.name,
      url: site.url,
      email: `mailto:${site.email}`,
      jobTitle: site.jobTitle,
      knowsAbout: [
        'Data pipelines',
        'Apache Kafka',
        'Java',
        'Python',
        'Machine learning',
        'Agents',
        'Problem solving',
        'Local Lattice',
      ],
      knowsLanguage: ['en', 'ko'],
      alumniOf: education.map((item) => ({
        '@type': 'CollegeOrUniversity',
        name: item.school,
      })),
      hasOccupation: {
        '@type': 'Occupation',
        name: site.jobTitle,
        occupationLocation: { '@type': 'City', name: 'New York' },
      },
      address: { '@type': 'PostalAddress', addressLocality: 'New York', addressRegion: 'NY' },
      sameAs: [site.github, site.linkedin],
      image: new URL(site.photo, site.url).href,
    })} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {isHome && <Starfield />}
    {!isResume && <Effects />}
    <Nav />
    <slot />
    <Footer />
    <script is:inline type="module">
      (() => {
        const motion = !matchMedia('(prefers-reduced-motion: reduce)').matches;
        const view =
          CSS.supports('animation-timeline', 'view()') ||
          CSS.supports('animation-timeline: view()');
        const nav = document.querySelector('.nav');
        const setNavOffset = () => {
          if (!nav) return;
          document.documentElement.style.setProperty('--nav-offset', `${nav.getBoundingClientRect().height}px`);
        };
        setNavOffset();
        if (nav && 'ResizeObserver' in window) new ResizeObserver(setNavOffset).observe(nav);
        addEventListener('resize', setNavOffset, { passive: true });

        const coarse = matchMedia('(pointer: coarse)').matches;
        if (motion && !coarse) {
          const spot = (e) => {
            const node = e.target;
            if (!(node instanceof Element)) return;
            const card = node.closest('.work-piece, .achieve-card, .spike, .case-brief, .role-scan');
            if (!card) return;
            const r = card.getBoundingClientRect();
            card.style.setProperty('--mx', `${e.clientX - r.left}px`);
            card.style.setProperty('--my', `${e.clientY - r.top}px`);
          };
          document.addEventListener('pointermove', spot, { passive: true });
        }
        if (motion && !view) {
          const io = new IntersectionObserver((entries, obs) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('is-in');
              obs.unobserve(e.target);
            }
          }, { rootMargin: '0px 0px -10% 0px', threshold: 0.08 });
          document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
        }
        const items = [];
        for (const a of document.querySelectorAll('.nav-links a')) {
          if (!a.hash) continue;
          const el = document.getElementById(a.hash.slice(1));
          if (el) items.push({ el, a });
        }
        if (!items.length) return;
        const visible = new Set();
        const sync = () => {
          const current = items.find((item) => visible.has(item.el));
          for (const item of items) {
            const on = item === current;
            item.a.classList.toggle('is-active', on);
            if (on) item.a.setAttribute('aria-current', 'location');
            else item.a.removeAttribute('aria-current');
          }
        };
        const spy = new IntersectionObserver((entries) => {
          for (const e of entries) e.isIntersecting ? visible.add(e.target) : visible.delete(e.target);
          sync();
        }, { rootMargin: '-28% 0px -58% 0px' });
        for (const item of items) spy.observe(item.el);
      })();
    </script>
  </body>
</html>
