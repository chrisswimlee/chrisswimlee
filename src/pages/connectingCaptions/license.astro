---
import Layout from '../../layouts/Layout.astro';
import { commercialLicense, connectingCaptions } from '../../data/site';
---

<Layout
  title={`${commercialLicense.title} — ${connectingCaptions.title}`}
  description={commercialLicense.lede}
>
  <main id="main" class="resume-page wrap">
    <div class="resume-top">
      <div>
        <p class="kicker">{commercialLicense.kicker}</p>
        <h1>{commercialLicense.heading}</h1>
      </div>
      <div class="resume-meta">
        <p>{commercialLicense.lede}</p>
        <div class="hero-actions">
          <a class="btn btn-solid" href={commercialLicense.href}>{commercialLicense.emailCta}</a>
          <a class="btn" href={connectingCaptions.path}>Get the zip</a>
          <a class="btn" href={connectingCaptions.repo} target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
    </div>

    <section class="resume-block" id="prices">
      <h2>Prices</h2>
      <ol class="engage-tiers">
        {commercialLicense.rates.map((item) => (
          <li>
            <p class="kicker">{item.unit}</p>
            <strong>{item.name}</strong>
            <p class="engage-price">{item.price}</p>
            <p>{item.detail}</p>
          </li>
        ))}
      </ol>
      <p class="resume-copy resume-copy-gap">
        Full comparison, App Store editions, and an estimator are on the
        <a href="/connectingCaptions/pricing/">pricing page</a>.
      </p>
    </section>

    <section class="resume-block">
      <h2>What you are buying</h2>
      <p class="resume-copy">
        The source is GPLv3; what a work license adds is something IT can file:
        a named organization, an offline activation key, and a person who
        answers when something breaks.
      </p>
      <ul class="points resume-list">
        {commercialLicense.includes.map((point) => (
          <li>{point}</li>
        ))}
      </ul>
    </section>

    <section class="resume-block">
      <h2>What IT usually asks</h2>
      <ul class="points">
        {commercialLicense.answers.map((item) => (
          <li>
            <strong>{item.question}</strong>
            {' '}
            {item.answer}
          </li>
        ))}
      </ul>
    </section>

    <section class="resume-block">
      <h2>How a key works</h2>
      <ul class="points">
        {commercialLicense.points.map((point) => (
          <li>{point}</li>
        ))}
      </ul>
      <p class="resume-copy resume-copy-gap">
        Paste the key under Settings → General. After the trial, Listen needs a
        key; a work key also shows <strong>Licensed to</strong> your organization.
      </p>
    </section>

    <section class="resume-block">
      <h2>Buy a license</h2>
      <p class="resume-copy">
        Email support@local-host.ai. {commercialLicense.buyCopy} If you want a
        system built, see <a href="/engage/">Engage</a>.
      </p>
      <div class="hero-actions">
        <a class="btn btn-solid" href={commercialLicense.href}>{commercialLicense.emailCta}</a>
      </div>
    </section>
  </main>
</Layout>
