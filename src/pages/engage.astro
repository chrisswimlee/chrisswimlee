---
import Layout from '../layouts/Layout.astro';
import Engage from '../components/Engage.astro';
import { engage, site } from '../data/site';
---

<Layout
  title={`Consulting — ${site.name}`}
  description={engage.lede}
>
  <main id="main" class="resume-page wrap">
    <div class="resume-top">
      <div>
        <p class="kicker">Consulting</p>
        <h1>{engage.heading}</h1>
      </div>
      <div class="resume-meta">
        <p>{engage.lede}</p>
        <div class="hero-actions">
          <a class="btn" href="/">Back to site</a>
          <a class="btn btn-solid" href={engage.href}>{engage.cta}</a>
        </div>
      </div>
    </div>
    <Engage />
  </main>
</Layout>
