---
import Layout from '../layouts/Layout.astro';
import Town from '../components/Town.astro';
import { site } from '../data/site';
import { townName } from '../data/town';
---

<Layout
  title={`${townName.owner}: ${townName.title} — ${site.name}`}
  description="Software engineer for AI and data systems. A walkable pixel town where every building is a job or a system: Goldman Sachs, a sub-100ms futures engine, local AI tools, and a college AI course."
>
  <Town />
</Layout>
