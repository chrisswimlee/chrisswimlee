---
import FluidInstallLinks from '../components/FluidInstallLinks.astro';
import Layout from '../layouts/Layout.astro';
import { commercialLicense, fluidSubtitles, fluidSubtitlesRelease, site } from '../data/site';
---

<Layout title={`${fluidSubtitles.title} — ${site.name}`} description={fluidSubtitles.description}>
  <main id="main" class="resume-page wrap">
    <div class="resume-top">
      <div>
        <p class="kicker">{fluidSubtitles.kicker}</p>
        <h1>{fluidSubtitles.title}</h1>
      </div>
      <div class="resume-meta">
        <p>{fluidSubtitles.lede}</p>
        <p class="project-langs">{fluidSubtitles.langs.join(' · ')}</p>
        <div class="hero-actions">
          <a class="btn btn-solid" href={fluidSubtitlesRelease.href}>Download {fluidSubtitlesRelease.version}</a>
          <a class="btn btn-solid" href={commercialLicense.path}>{commercialLicense.cta}</a>
          <a class="btn" href={fluidSubtitles.repo} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a class="btn" href="/#work">The work</a>
        </div>
      </div>
    </div>

    <div class="project-shots">
      <figure class="project-shot">
        <img
          src={fluidSubtitles.image}
          alt="Theater captions: Hello. and 안녕."
          width="1200"
          height="750"
        />
      </figure>
      <figure class="project-shot">
        <img
          src={fluidSubtitles.homeImage}
          alt="Theater Home: English to Korean, on this Mac."
          width="1200"
          height="750"
        />
      </figure>
    </div>

    <section class="resume-block" id="install">
      <h2>Install</h2>
      <p class="resume-copy">{fluidSubtitles.installLede}</p>
      <FluidInstallLinks />
      <ol class="points project-steps">
        {fluidSubtitles.open.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
    </section>

    <div class="project-split">
      <section class="resume-block">
        <h2>What it is</h2>
        <ul class="points">
          {fluidSubtitles.about.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </section>
      <section class="resume-block">
        <h2>What you need</h2>
        <ul class="points">
          {fluidSubtitles.needs.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </section>
    </div>

    <section class="resume-block" id="work">
      <h2>{commercialLicense.workTitle}</h2>
      <p class="resume-copy">{commercialLicense.workLede}</p>
      <ul class="points resume-list">
        {commercialLicense.answers.map((item) => (
          <li>
            <strong>{item.question}</strong>
            {' '}
            {item.answer}
          </li>
        ))}
      </ul>
      <div class="hero-actions">
        <a class="btn btn-solid" href={commercialLicense.path}>{commercialLicense.cta}</a>
        <a class="btn" href={commercialLicense.href}>{commercialLicense.emailCta}</a>
      </div>
    </section>
  </main>
</Layout>

<script>
  import '../scripts/copy-buttons';
</script>
