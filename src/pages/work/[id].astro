---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { projects, site, storyPath } from '../../data/site';

export function getStaticPaths() {
  return projects
    .filter((project) => project.story)
    .map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: (typeof projects)[number] };
const story = project.story!;
const others = projects.filter((item) => item.story && item.id !== project.id);
const offsite = (href: string) => /^https?:\/\//.test(href);
const steps = [
  ['Problem', story.brief.problem],
  ['Constraint', story.brief.constraint],
  ['Decision', story.brief.decision],
  ['Outcome', story.brief.outcome],
] as const;

const jsonLd = {
  '@type': 'CreativeWork',
  name: project.title,
  description: project.summary,
  url: new URL(storyPath(project.id), site.url).href,
  dateCreated: project.year,
  keywords: story.stack.join(', '),
  author: { '@type': 'Person', name: site.legalName, url: site.url },
};
---

<Layout title={`${project.title} — ${site.name}`} description={project.summary} jsonLd={jsonLd}>
  <main id="main" class="resume-page story-page wrap">
    <div class="resume-top">
      <div>
        <p class="kicker">{project.kind} · {project.year}</p>
        <h1>{project.title}</h1>
      </div>
      <div class="resume-meta">
        <p>{project.summary}</p>
        <div class="tags story-tags">
          {story.stack.map((item) => <span class="tag">{item}</span>)}
        </div>
        <div class="hero-actions">
          {
            project.links.map((link, index) => (
              <a
                class:list={['btn', index === 0 && 'btn-solid']}
                href={link.href}
                target={offsite(link.href) ? '_blank' : undefined}
                rel={offsite(link.href) ? 'noopener noreferrer' : undefined}
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class:list={['project-shots', story.shots.length === 1 && 'story-shots-single']}>
      {
        story.shots.map((shot, index) => (
          <figure class="project-shot">
            <Image
              src={shot.image}
              alt={shot.alt}
              widths={[600, 900, 1200, 1600]}
              sizes={
                story.shots.length === 1
                  ? '(max-width: 1240px) calc(100vw - 2.4rem), 1200px'
                  : '(max-width: 860px) calc(100vw - 2.4rem), 600px'
              }
              format="webp"
              quality={80}
              loading={index === 0 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : undefined}
            />
          </figure>
        ))
      }
    </div>

    <div class="project-split">
      <section class="resume-block">
        <h2>How it came together</h2>
        <dl class="case-steps">
          {
            steps.map(([label, text]) => (
              <div>
                <dt>{label}</dt>
                <dd>{text}</dd>
              </div>
            ))
          }
        </dl>
      </section>
      <section class="resume-block">
        <h2>What it does</h2>
        <ul class="points">
          {project.points.map((point) => <li>{point}</li>)}
        </ul>
        {
          project.command && (
            <div class="get-cmd">
              <button class="cmd-copy" type="button" data-copy={project.command}>
                Copy
              </button>
              <code>{project.command}</code>
            </div>
          )
        }
      </section>
    </div>

    <section class="resume-block">
      <h2>More work</h2>
      <div class="hero-actions">
        {others.map((item) => <a class="btn" href={storyPath(item.id)}>{item.title}</a>)}
        <a class="btn btn-text" href="/hire/#work">All projects</a>
      </div>
    </section>
  </main>
</Layout>

<script>
  import '../../scripts/copy-buttons';
</script>
