---
import Layout from '../layouts/Layout.astro';
import {
  competitive,
  education,
  range,
  roles,
  site,
  skills,
  technicalAchievements,
} from '../data/site';
---

<Layout
  title={`Resume — ${site.name}`}
  description={`Resume for ${site.legalName}: problem solver in New York. Six years in data pipelines, agents, and modular systems.`}
>
  <main id="main" class="resume-page wrap">
    <div class="resume-top">
      <div>
        <p class="kicker">Resume</p>
        <h1>{site.legalName}</h1>
      </div>
      <div class="resume-meta">
        <p>{site.location}</p>
        <p>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <p>
          <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          {' · '}
          <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          {' · '}
          <a href={site.url}>{site.url.replace('https://', '')}</a>
        </p>
        <div class="hero-actions">
          <a class="btn" href="/">Back to site</a>
          <button class="btn" type="button" onclick="window.print()">Print / PDF</button>
        </div>
      </div>
    </div>

    <section class="resume-block">
      <h2>Profile</h2>
      <p class="resume-copy">
        Problem solver. I love coding, learning a business from the inside, and
        shipping the system that comes out of both. Put the unfamiliar stack in
        front of me — I learn it, break the work into modules, and leave something
        you can upgrade. Six years: Goldman infrastructure, then founding CTO on
        an agentic trading stack.
      </p>
      <ul class="resume-copy resume-list">
        <li>I solve problems. I want as many as I can take — especially the ones that invest in AI.</li>
        <li>I attack the constraint, cut the work into parts, and learn what I do not know yet.</li>
        <li>I leave modular systems so the next version has a place to land.</li>
        {
          range.spikes.map((spike) => (
            <li>
              <strong>{spike.label}.</strong> {spike.domain} — {spike.trains}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="resume-block">
      <h2>Experience</h2>
      <div class="timeline">
        {
          roles.map((role) => (
            <article class="role">
              <div class="when-col">
                <p class="when">{role.dates}</p>
                {role.location && <p class="when">{role.location}</p>}
              </div>
              <div>
                <h3>{role.title}</h3>
                <p class="company">{role.company}</p>
                {role.note && <p class="role-note">{role.note}</p>}
                <ul>
                  {role.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="resume-block">
      <h2>Open source</h2>
      <p class="resume-copy">
        <strong>Local Lattice</strong> — local-first OpenAI-compatible
        capability gateway (Apache-2.0). Agents ask for a role, not a model string. Capability
        routing, admission queue, hybrid local + cloud swarm.
        {' '}
        <a href="/#systems">The method</a>
        {' · '}
        <a href="https://github.com/chrisswimlee/local-lattice" target="_blank" rel="noopener noreferrer">github.com/chrisswimlee/local-lattice</a>
      </p>
    </section>

    <section class="resume-block">
      <h2>Public work</h2>
      <p class="resume-copy">
        <strong>HAIT</strong> — public site for Hebron Asia
        International Institute of Technology, an AI university in Chiang Rai.
        Redesigned the front-end, upgraded the PHP, and fixed performance so recruiting works before
        there is a campus.
        {' '}
        <a href="https://haitedu.com" target="_blank" rel="noopener noreferrer">haitedu.com</a>
      </p>
      <p class="resume-copy resume-copy-gap">
        <strong>D22-soso</strong> — site for Wayne “D22-soso” Chiang,
        1999 Brood War World Champion, WSOP talent manager, and inventor of 2 Hand Hold’em.
        {' '}
        <a href="https://d22soso.com" target="_blank" rel="noopener noreferrer">d22soso.com</a>
      </p>
    </section>

    <section class="resume-block">
      <h2>Education</h2>
      {
        education.map((item) => (
          <article class="role">
            <div>
              <p class="when">{item.dates}</p>
            </div>
            <div>
              <h3>{item.degree}</h3>
              <p class="company">{item.school}</p>
              {item.note && <p class="resume-copy">{item.note}</p>}
            </div>
          </article>
        ))
      }
    </section>

    <section class="resume-block">
      <h2>Skills</h2>
      {
        Object.entries(skills).map(([group, items]) => (
          <div class="skill-block">
            <h3>{group}</h3>
            <div class="tags">
              {items.map((item) => (
                <span class="tag">{item}</span>
              ))}
            </div>
          </div>
        ))
      }
    </section>

    <section class="resume-block">
      <h2>Technical achievements</h2>
      <ul class="resume-copy resume-list">
        {
          technicalAchievements.map((item) => (
            <li>
              <strong>{item.label} — {item.prefix ?? ''}{item.value.toLocaleString('en-US')}{item.suffix}.</strong>
              {' '}
              {item.claim} {item.proof}
              {item.todo ? ` ${item.todo}` : ''}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="resume-block">
      <h2>Competitive achievements</h2>
      {
        competitive.map((item) => (
          <>
            <p class="resume-copy">
              <strong>{item.title}.</strong> {item.detail}
            </p>
            <p class="resume-copy resume-copy-gap">
              {item.links.map((link, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={link.href} target="_blank" rel="noopener noreferrer">
                    {link.label}
                  </a>
                </>
              ))}
            </p>
          </>
        ))
      }
    </section>

  </main>
</Layout>
