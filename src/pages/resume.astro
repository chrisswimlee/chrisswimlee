---
import Layout from '../layouts/Layout.astro';
import {
  competitive,
  education,
  roles,
  site,
  skills,
  technicalAchievements,
} from '../data/site';
---

<Layout
  title={`Resume — ${site.name}`}
  description={`Resume for ${site.legalName}: forward-deployed data systems, local-host.ai, Connecting Captions, and a college course.`}
>
  <main id="main" class="resume-page wrap">
    <div class="resume-top">
      <div>
        <p class="kicker">Resume</p>
        <h1>{site.legalName}</h1>
      </div>
      <div class="resume-meta">
        <p>{site.location}</p>
        <p>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <p>
          <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          {' · '}
          <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          {' · '}
          <a href={site.url}>{site.url.replace('https://', '')}</a>
        </p>
        <div class="hero-actions">
          <a class="btn" href="/">Back to site</a>
          <button class="btn" type="button" onclick="window.print()">Print / PDF</button>
        </div>
      </div>
    </div>

    <section class="resume-block">
      <h2>Profile</h2>
      <p class="resume-copy">
        Software engineer. Three years at Goldman Sachs working with developers, traders, and lawyers,
        then a live futures engine as founding CTO, and earlier, systems for defense clients.
        Now I teach and run IT at HAIT. I also build local-host.ai. Connecting Captions,
        live subtitles for the Mac, is the first release. A local agent is next.
      </p>
    </section>

    <section class="resume-block">
      <h2>Experience</h2>
      <div class="timeline">
        {
          roles.map((role) => (
            <article class="role">
              <div class="when-col">
                <p class="when">{role.dates}</p>
                {role.location && <p class="when">{role.location}</p>}
              </div>
              <div>
                <h3>{role.title}</h3>
                <p class="company">{role.company}</p>
                {role.note && <p class="role-note">{role.note}</p>}
                <ul>
                  {role.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="resume-block">
      <h2>Open source</h2>
      <p class="resume-copy">
        <strong>local-host.ai</strong> — software that stays on the Mac. Connecting Captions
        is the first release. Next is an agent that runs on the machine, keeps its memory on disk,
        and uses skills you can open.
        {' '}
        <a href="https://local-host.ai" target="_blank" rel="noopener noreferrer">local-host.ai</a>
        {' · '}
        <a href="https://github.com/chrisswimlee/local-host.ai" target="_blank" rel="noopener noreferrer">github.com/chrisswimlee/local-host.ai</a>
      </p>
      <p class="resume-copy resume-copy-gap">
        <strong>Connecting Captions</strong> — live subtitles for the Mac (GPLv3).
        Translation happens on the machine, and each sentence appears as soon as it’s ready.
        {' '}
        <a href="/connectingCaptions/">Get it</a>
        {' · '}
        <a href="https://github.com/chrisswimlee/connectingCaptions" target="_blank" rel="noopener noreferrer">github.com/chrisswimlee/connectingCaptions</a>
      </p>
      <p class="resume-copy resume-copy-gap">
        <strong>DeskBreak</strong> — macOS menu-bar timer (MIT). After
        40 minutes, a little character tells you to stand. Nothing leaves your Mac.
        {' '}
        <a href="/#work">The work</a>
        {' · '}
        <a href="https://github.com/chrisswimlee/deskbreak" target="_blank" rel="noopener noreferrer">github.com/chrisswimlee/deskbreak</a>
      </p>
      <p class="resume-copy resume-copy-gap">
        <strong>Local Lattice</strong> — local gateway that speaks the
        OpenAI API (Apache-2.0). You ask for a role like coder or reasoner,
        and it chooses the model.
        {' '}
        <a href="/#work">The work</a>
        {' · '}
        <a href="https://github.com/chrisswimlee/local-lattice" target="_blank" rel="noopener noreferrer">github.com/chrisswimlee/local-lattice</a>
      </p>
    </section>

    <section class="resume-block">
      <h2>Public work</h2>
      <p class="resume-copy">
        <strong>HAIT</strong> — public site and systems for Hebron Asia
        International Institute of Technology, an AI institute in Chiang Rai.
        I rebuilt the front end and the PHP underneath it.
        {' '}
        <a href="https://haitedu.com" target="_blank" rel="noopener noreferrer">haitedu.com</a>
      </p>
      <p class="resume-copy resume-copy-gap">
        <strong>D22-soso</strong> — site for Wayne “D22-soso” Chiang,
        1999 Brood War World Champion, WSOP talent manager, and inventor of 2 Hand Hold’em.
        {' '}
        <a href="https://d22soso.com" target="_blank" rel="noopener noreferrer">d22soso.com</a>
      </p>
    </section>

    <section class="resume-block">
      <h2>Education</h2>
      {
        education.map((item) => (
          <article class="role">
            <div>
              <p class="when">{item.dates}</p>
            </div>
            <div>
              <h3>{item.degree}</h3>
              <p class="company">{item.school}</p>
              {item.note && <p class="resume-copy">{item.note}</p>}
            </div>
          </article>
        ))
      }
    </section>

    <section class="resume-block">
      <h2>Skills</h2>
      {
        Object.entries(skills).map(([group, items]) => (
          <div class="skill-block">
            <h3>{group}</h3>
            <div class="tags">
              {items.map((item) => (
                <span class="tag">{item}</span>
              ))}
            </div>
          </div>
        ))
      }
    </section>

    <section class="resume-block">
      <h2>Technical achievements</h2>
      <ul class="resume-copy resume-list">
        {
          technicalAchievements.map((item) => (
            <li>
              <strong>{item.place}, {item.when}.</strong>
              {' '}
              {item.claim} {item.proof}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="resume-block">
      <h2>Competitive achievements</h2>
      {
        competitive.map((item) => (
          <>
            <p class="resume-copy">
              <strong>{item.title}.</strong> {item.detail}
            </p>
            <p class="resume-copy resume-copy-gap">
              {item.links.map((link, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={link.href} target="_blank" rel="noopener noreferrer">
                    {link.label}
                  </a>
                </>
              ))}
            </p>
          </>
        ))
      }
    </section>

  </main>
</Layout>
