---
import Layout from '../layouts/Layout.astro';
import { commercialLicense, connectingCaptions, releaseDownload, site } from '../data/site';

const brew = connectingCaptions.brew.join('\n');
---

<Layout title={`${connectingCaptions.title} — ${site.name}`} description={connectingCaptions.description}>
  <main id="main" class="resume-page wrap">
    <div class="resume-top">
      <div>
        <p class="kicker">{connectingCaptions.kicker}</p>
        <h1>{connectingCaptions.title}</h1>
      </div>
      <div class="resume-meta">
        <p>{connectingCaptions.lede}</p>
        <p class="project-langs">{connectingCaptions.langs.join(' · ')}</p>
        <div class="hero-actions">
          <a class="btn btn-solid" href={releaseDownload.href}>Download Connecting Captions</a>
          <a class="btn btn-solid" href={commercialLicense.path}>{commercialLicense.cta}</a>
          <a class="btn" href={connectingCaptions.repo} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a class="btn" href="/#work">The work</a>
        </div>
      </div>
    </div>

    <div class="project-shots">
      <figure class="project-shot">
        <img
          src={connectingCaptions.image}
          alt="Theater captions: Hello. and 안녕."
          width="1200"
          height="750"
        />
      </figure>
      <figure class="project-shot">
        <img
          src={connectingCaptions.homeImage}
          alt="Theater Home: English to Korean, on this Mac."
          width="1200"
          height="750"
        />
      </figure>
    </div>

    <section class="resume-block" id="install">
      <h2>Install</h2>
      <p class="resume-copy">
        Unzip <strong>{releaseDownload.name}</strong> and drag Connecting Captions to Applications. No Xcode.
      </p>
      <div class="hero-actions">
        <a class="btn btn-solid" href={releaseDownload.href}>Download Connecting Captions</a>
        <a class="btn" href={releaseDownload.page} target="_blank" rel="noopener noreferrer">Release notes</a>
      </div>
      <p class="resume-copy resume-copy-gap">
        Or install Connecting Captions with Homebrew.
      </p>
      <div class="get-cmd">
        <code>{brew}</code>
        <button id="brew-copy" class="cmd-copy" type="button">Copy</button>
      </div>
      <ol class="points project-steps">
        <li>Run the three Homebrew commands. Trust the tap when asked.</li>
        {connectingCaptions.open.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
    </section>

    <div class="project-split">
      <section class="resume-block">
        <h2>What it is</h2>
        <ul class="points">
          {connectingCaptions.about.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </section>
      <section class="resume-block">
        <h2>What you need</h2>
        <ul class="points">
          {connectingCaptions.needs.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </section>
    </div>

    <section class="resume-block" id="work">
      <h2>{commercialLicense.workTitle}</h2>
      <p class="resume-copy">{commercialLicense.workLede}</p>
      <ul class="points resume-list">
        {commercialLicense.answers.map((item) => (
          <li>
            <strong>{item.question}</strong>
            {' '}
            {item.answer}
          </li>
        ))}
      </ul>
      <div class="hero-actions">
        <a class="btn btn-solid" href={commercialLicense.path}>{commercialLicense.cta}</a>
        <a class="btn" href={commercialLicense.href}>{commercialLicense.emailCta}</a>
      </div>
    </section>
  </main>
</Layout>

<script>
  import '../scripts/copy-buttons';
</script>
<script define:vars={{ brew }}>
  const btn = document.getElementById('brew-copy');
  if (btn) btn.dataset.copy = brew;
</script>
