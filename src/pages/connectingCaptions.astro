---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import VantaFog from '../components/VantaFog.astro';
import theaterShot from '../assets/work/connectingCaptions-theater.jpg';
import languagesShot from '../assets/work/connectingCaptions-languages.jpg';
import { commercialLicense, connectingCaptions, releaseDownload, site, storyPath } from '../data/site';

const brew = connectingCaptions.brew.join('\n');

const appJsonLd = {
  '@type': 'SoftwareApplication',
  name: connectingCaptions.title,
  description: connectingCaptions.description,
  url: new URL(connectingCaptions.path, site.url).href,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'macOS 15 or later',
  downloadUrl: releaseDownload.href,
  installUrl: releaseDownload.page,
  softwareRequirements: 'Microphone access. Theater streaming needs Apple Silicon.',
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  image: new URL(connectingCaptions.image.src, site.url).href,
  codeRepository: connectingCaptions.repo,
  author: { '@type': 'Person', name: site.legalName, url: site.url },
  inLanguage: ['ko', 'en', 'th', 'ja'],
};
---

<Layout
  title={`${connectingCaptions.title} — ${site.name}`}
  description={connectingCaptions.description}
  jsonLd={appJsonLd}
>
  <VantaFog />
  <main id="main" class="resume-page wrap">
    <div class="resume-top">
      <div>
        <p class="kicker">{connectingCaptions.kicker}</p>
        <h1>{connectingCaptions.title}</h1>
      </div>
      <div class="resume-meta">
        <p>{connectingCaptions.lede}</p>
        <p class="project-langs">{connectingCaptions.langs.join(' · ')}</p>
        <div class="hero-actions">
          <a class="btn btn-solid" href={releaseDownload.href}>Download Connecting Captions</a>
          <a class="btn" href={commercialLicense.path}>{commercialLicense.cta}</a>
          <a class="btn btn-text" href={connectingCaptions.repo} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a class="btn btn-text" href={storyPath('connectingCaptions')}>How it was built</a>
        </div>
      </div>
    </div>

    <div class="project-shots">
      <figure class="project-shot">
        <Image
          src={theaterShot}
          alt="Theater captions: Hello. and 안녕."
          widths={[600, 900, 1200]}
          sizes="(max-width: 860px) calc(100vw - 2.4rem), 600px"
          format="webp"
          quality={80}
          loading="eager"
          fetchpriority="high"
        />
      </figure>
      <figure class="project-shot">
        <Image
          src={languagesShot}
          alt="Theater Home: English to Korean, on this Mac."
          widths={[600, 900, 1200]}
          sizes="(max-width: 860px) calc(100vw - 2.4rem), 600px"
          format="webp"
          quality={80}
          loading="eager"
        />
      </figure>
    </div>

    <section class="resume-block" id="install">
      <h2>Install</h2>
      <p class="resume-copy">
        Unzip <strong>{releaseDownload.name}</strong> and drag Connecting Captions to Applications. No Xcode.
      </p>
      <p class="resume-copy resume-copy-gap">
        <a href={releaseDownload.page} target="_blank" rel="noopener noreferrer">Release notes</a> are on GitHub.
        Or install Connecting Captions with Homebrew. Trust the tap when asked.
      </p>
      <div class="get-cmd">
        <button id="brew-copy" class="cmd-copy" type="button">Copy</button>
        <code>{brew}</code>
      </div>
      <ol class="points project-steps">
        {connectingCaptions.open.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
    </section>

    <div class="project-split">
      <section class="resume-block">
        <h2>What it is</h2>
        <ul class="points">
          {connectingCaptions.about.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </section>
      <section class="resume-block">
        <h2>What you need</h2>
        <ul class="points">
          {connectingCaptions.needs.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </section>
    </div>

    <section class="resume-block" id="work">
      <h2>{commercialLicense.workTitle}</h2>
      <p class="resume-copy">{commercialLicense.workLede}</p>
      <ul class="points resume-list">
        {commercialLicense.answers.map((item) => (
          <li>
            <strong>{item.question}</strong>
            {' '}
            {item.answer}
          </li>
        ))}
      </ul>
      <div class="hero-actions">
        <a class="btn btn-solid" href={commercialLicense.path}>{commercialLicense.cta}</a>
        <a class="btn" href={commercialLicense.href}>{commercialLicense.emailCta}</a>
      </div>
    </section>
  </main>
</Layout>

<script>
  import '../scripts/copy-buttons';
</script>
<script define:vars={{ brew }}>
  const btn = document.getElementById('brew-copy');
  if (btn) btn.dataset.copy = brew;
</script>
